%% Hình 4.1 — Kiến trúc tổng thể (MSA) — style lớp rõ như AWS architecture diagram
%% Quy tắc: mỗi hộp = 1 service/thành phần thật trong repo; mũi tên đánh số = luồng chính;
%%           KHÔNG vẽ Cognito/Neptune/AppSync nếu code không dùng; KHÔNG để tên cũ (trip-service/voice-agent).
%%           llm-orchestrator = STT → LLM + tools → TTS (+ filler ~2s) — không “đường tắt” hardcode.
%% Export: npx @mermaid-js/mermaid-cli@11.4.2 -i H4_1_architecture.mmd -o H4_1_architecture.png -b white -w 1800
%% Ref style: REF_aws_layered_architecture_style.png · [[thesis_aws_diagram_clarity]]
flowchart TB
  subgraph L1["① Presentation · Tầng trình bày"]
    direction LR
    APP["driver-app<br/><i>Ứng dụng tài xế · React Native / Expo</i>"]
    WEB["admin / super-admin web<br/><i>Vite · vận hành</i>"]
  end

  subgraph L2["② Authentication · Tầng xác thực"]
    direction LR
    ID["identity-service<br/><i>Đăng nhập · phát/verify JWT · cài đặt</i>"]
  end

  subgraph L2b["②b Client API · Cổng HTTP"]
    direction LR
    GW["API Gateway / ALB<br/><i>Điểm vào HTTP công khai</i>"]
  end

  subgraph L3["③ Realtime media · Truyền thông thời gian thực"]
    direction LR
    LK["LiveKit Cloud<br/><i>WebRTC + SIP · phòng hội thoại</i>"]
    ORCH["llm-orchestrator<br/><i>STT → LLM + tools → TTS · ECS worker</i>"]
  end

  subgraph L4["④ API microservices · Dịch vụ nghiệp vụ"]
    direction LR
    API["external-api-service<br/><i>Chuyến · ngữ cảnh · token thoại · SoT HTTP</i>"]
    CH["external-channel-service<br/><i>PSTN / SMS · Twilio webhook</i>"]
    REC["call-records-service<br/><i>Transcript · tóm tắt cuộc gọi</i>"]
  end

  subgraph L5["⑤ Data · Tầng dữ liệu"]
    direction LR
    DB[("DynamoDB<br/><i>Bảng theo service sở hữu · không chia sẻ ghi chéo</i>")]
  end

  subgraph L6["⑥ Monitoring · Tầng giám sát"]
    direction LR
    OPS["ops-service<br/><i>Health · tail log · BFF vận hành</i>"]
    CW["CloudWatch<br/><i>Log / metric theo room</i>"]
  end

  APP -->|"① đăng nhập"| ID
  ID -->|"② JWT"| APP
  APP -->|"③ token thoại · chuyến"| GW
  GW -->|"④"| API
  APP -->|"⑤ âm thanh in-app"| LK
  API -->|"⑥ tạo phòng / dispatch"| LK
  LK <-->|"⑦ media"| ORCH
  ORCH -->|"⑧ HTTP tools · không mở DB"| API
  API -->|"⑨ đọc/ghi chuyến"| DB
  ID -->|"⑩ tài khoản"| DB
  ORCH -.->|"⑪ ghi vết hội thoại"| REC
  REC -->|"⑫"| DB
  API -.->|"⑬ điều phối gọi"| CH
  CH -.->|"⑭ SIP / PSTN"| LK
  WEB -->|"⑮ vận hành"| OPS
  OPS -.->|"⑯ proxy / health"| API
  OPS -.->|"⑰ tail"| CW
  ORCH -.->|"⑱ DEV log room="| CW

  classDef present fill:#FEF3C7,stroke:#B45309,stroke-width:1.5px,color:#0F172A
  classDef auth fill:#FCE7F3,stroke:#BE185D,stroke-width:1.5px,color:#0F172A
  classDef entry fill:#E0F2FE,stroke:#0369A1,stroke-width:1.5px,color:#0F172A
  classDef realtime fill:#EFF6FF,stroke:#1D4ED8,stroke-width:1.5px,color:#0F172A
  classDef api fill:#ECFDF5,stroke:#047857,stroke-width:1.5px,color:#0F172A
  classDef data fill:#F1F5F9,stroke:#334155,stroke-width:1.5px,color:#0F172A
  classDef mon fill:#F5F3FF,stroke:#6D28D9,stroke-width:1.5px,color:#0F172A

  class APP,WEB present
  class ID auth
  class GW entry
  class LK,ORCH realtime
  class API,CH,REC api
  class DB data
  class OPS,CW mon
