# llm-orchestrator (Tác tử hội thoại giọng nói) — copied by infra/setup-env.sh
ENV=dev
AWS_REGION=ap-southeast-1
# AWS_PROFILE=your-profile

JWT_SECRET=

# Filled by infra/deploy-all.sh after external-api-service / call-records-service deploy
EXTERNAL_API_SERVICE_URL=
CALL_RECORDS_SERVICE_URL=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI providers
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
DEEPGRAM_API_KEY=

STT_PROVIDER=openai
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
TTS_PROVIDER=elevenlabs

TWILIO_PHONE_NUMBER=

# VPC — auto-filled by setup-env.sh if AWS CLI configured
VPC_ID=
SUBNET_IDS=

# 0 = no idle ECS cost; N = N agent worker tasks (horizontal scaling)
DESIRED_COUNT=0

# FAQ RAG
FAQ_RAG_ENABLED=true
