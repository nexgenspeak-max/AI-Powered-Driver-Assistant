ENV=dev
AWS_REGION=ap-southeast-1
# AWS_PROFILE=your-profile

JWT_SECRET=

# Filled by deploy-all.sh after external-api-service deploy
TRIP_SERVICE_URL=
CALL_LOGGER_URL=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
DEEPGRAM_API_KEY=

STT_PROVIDER=openai
LLM_PROVIDER=openai
TTS_PROVIDER=elevenlabs

TWILIO_PHONE_NUMBER=

# VPC — auto-filled by setup-env.sh if AWS CLI configured
VPC_ID=
SUBNET_IDS=

# 0 = no idle ECS cost; 1 = worker runs 24/7 (~$41/month + ALB ~$18)
DESIRED_COUNT=0

# FAQ RAG
FAQ_RAG_ENABLED=true
