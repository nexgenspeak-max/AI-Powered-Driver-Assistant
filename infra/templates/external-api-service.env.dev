# external-api-service (Dịch vụ Chuyến đi và Điều phối) — copied by infra/setup-env.sh
ENV=dev
AWS_REGION=ap-southeast-1
# AWS_PROFILE=your-profile

JWT_SECRET=

# Filled by infra/deploy-all.sh after the dependent stacks deploy (or paste manually)
IDENTITY_SERVICE_URL=
CALL_RECORDS_SERVICE_URL=
EXTERNAL_CHANNEL_SERVICE_URL=

# LiveKit (same project as local, or separate dev project)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=driver-assistant-dev
SIP_TRUNK_ID=

MAPS_PROVIDER=goong
MAPS_API_KEY=

# Optional — in-memory fallback if unset (not recommended for AWS)
REDIS_URL=

# Twilio verified number for trial accounts
TWILIO_VERIFIED_TO=
