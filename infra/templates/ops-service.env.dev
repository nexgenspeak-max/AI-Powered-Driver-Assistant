# ops-service (Dịch vụ Giám sát vận hành) — copied by infra/setup-env.sh
ENV=dev
AWS_REGION=ap-southeast-1
# AWS_PROFILE=your-profile

# Shared JWT (only super_admin tokens are accepted)
JWT_SECRET=

# Daily report: LLM grading of a sample of driver exchanges; empty = not graded
OPENAI_API_KEY=
REPORT_JUDGE_MODEL=gpt-4o-mini
REPORT_JUDGE_SAMPLE=30
