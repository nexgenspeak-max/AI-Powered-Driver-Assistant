# identity-service (Dịch vụ Định danh) — copied to src/backend/identity-service/envs/.env.dev by infra/setup-env.sh
ENV=dev
AWS_REGION=ap-southeast-1
# AWS_PROFILE=your-profile

# Shared with external-api-service, external-channel-service, call-records-service, llm-orchestrator
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
