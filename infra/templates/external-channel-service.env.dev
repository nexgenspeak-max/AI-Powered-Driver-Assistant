# external-channel-service (Dịch vụ Kênh liên lạc) — copied by infra/setup-env.sh
ENV=dev
AWS_REGION=ap-southeast-1
# AWS_PROFILE=your-profile

# Shared JWT (verify only)
JWT_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public base URL of this service (Twilio webhooks); filled after first deploy
BASE_URL=
