
digraph H41 {
  graph [
    rankdir=TB
    bgcolor="white"
    pad="0.5"
    nodesep="0.55"
    ranksep="0.55"
    fontname="Arial Unicode MS"
    splines=ortho
    newrank=true
  ];
  node [
    shape=box
    style="rounded,filled"
    fillcolor="#F8FAFC"
    color="#111827"
    fontname="Arial Unicode MS"
    fontsize=14
    fontcolor="#111827"
    penwidth=1.5
    margin="0.22,0.14"
    height=0.7
  ];
  edge [
    fontname="Arial Unicode MS"
    fontsize=11
    fontcolor="#6B7280"
    color="#111827"
    penwidth=1.15
    arrowsize=0.65
  ];

  driver [label="Ứng dụng tài xế (React Native / Expo)"];
  livekit [label="LiveKit Cloud  ·  WebRTC + SIP" fillcolor="#EFF6FF" color="#1D4ED8"];
  voice [label="voice-agent (Python / LiveKit Agents)" fillcolor="#EFF6FF" color="#1D4ED8"];
  pipe [label="STT  →  đường tắt / LLM + tool  →  TTS" fillcolor="#F0FDF4" color="#15803D"];

  auth [label="auth-service\nĐăng nhập · JWT · settings"];
  trip [label="trip-service\nChuyến · token thoại · context"];
  callc [label="call-center\nQuay số PSTN"];
  calll [label="call-logger\nLưu vết / transcript"];

  { rank=same; driver }
  { rank=same; livekit }
  { rank=same; voice; pipe }
  { rank=same; auth; trip; callc; calll }

  driver -> livekit [xlabel="âm thanh in-app"];
  driver -> auth [xlabel="đăng nhập"];
  driver -> trip [xlabel="token / chuyến"];
  livekit -> voice [xlabel="phòng · mic–loa"];
  voice -> pipe [style=dashed xlabel="pipeline"];
  voice -> trip [xlabel="HTTP (không mở DB)"];
  voice -> calll [style=dashed xlabel="log"];
  trip -> callc [xlabel="điều phối gọi"];
  callc -> livekit [style=dashed xlabel="SIP" constraint=false];
}
