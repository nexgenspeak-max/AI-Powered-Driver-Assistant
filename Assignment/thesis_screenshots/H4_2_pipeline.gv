
digraph H42 {
  graph [
    rankdir=TB
    bgcolor="white"
    pad="0.45"
    nodesep="0.40"
    ranksep="0.42"
    fontname="Arial Unicode MS"
    splines=true
  ];
  node [
    shape=box
    style="rounded,filled"
    fillcolor="#F8FAFC"
    color="#111827"
    fontname="Arial Unicode MS"
    fontsize=13
    fontcolor="#111827"
    penwidth=1.5
    margin="0.18,0.12"
  ];
  edge [
    fontname="Arial Unicode MS"
    fontsize=11
    fontcolor="#6B7280"
    color="#111827"
    penwidth=1.15
    arrowsize=0.65
  ];

  start [shape=ellipse label="Tài xế nói" fillcolor="#EFF6FF" color="#1D4ED8"];
  stt [label="STT → chữ (chốt câu)"];
  decide [
    shape=diamond
    label="Khớp ý định\nquen thuộc?"
    fillcolor="#FFFBEB"
    color="#B45309"
    width=2.0
    height=1.0
    fontsize=12
  ];

  fast [label="① Đường tắt\nspoken_intent → tool\n(+ StopResponse)" fillcolor="#F0FDF4" color="#15803D"];
  llm [label="② Đường đủ\nLLM + schema tool" fillcolor="#EFF6FF" color="#1D4ED8"];
  chat [label="③ Trò chuyện nhẹ\nkhông nạp bảng tool"];

  http [label="HTTP → trip-service (khi cần)"];
  prefetch [
    label="Prefetch ngữ cảnh lúc vào phiên"
    style="rounded,filled,dashed"
    fillcolor="#EFF6FF"
    color="#1D4ED8"
    fontsize=11
  ];
  tts [label="TTS → câu trả lời ngắn trên loa"];
  stop [shape=ellipse label="Kết thúc lượt" fillcolor="#EFF6FF" color="#1D4ED8"];

  start -> stt -> decide;
  decide -> fast [label=" có " fontcolor="#15803D" color="#15803D"];
  decide -> llm [label=" mơ hồ "];
  decide -> chat [label=" xã giao "];
  { rank=same; fast; llm; chat }
  fast -> http;
  llm -> http;
  prefetch -> http [style=dashed];
  http -> tts;
  chat -> tts;
  tts -> stop;
}
