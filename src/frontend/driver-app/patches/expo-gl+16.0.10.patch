+        // A real remount (component key change) fires a genuine new
+        // onSurfaceCreate that resolves this on its own.
+        if (!gl) {
+            if (__DEV__) {
+                console.warn('GLView: onSurfaceCreate fired for an orphaned context id (likely a Fast Refresh registry reset) — skipping onContextCreate.');
