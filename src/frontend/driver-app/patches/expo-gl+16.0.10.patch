     };
     _onSurfaceCreate = ({ nativeEvent: { exglCtxId } }) => {
         const gl = getGl(exglCtxId);
+        // Fast Refresh can reset `global.__EXGLContexts` without the native
+        // surface re-firing a fresh onSurfaceCreate, so this event can carry
