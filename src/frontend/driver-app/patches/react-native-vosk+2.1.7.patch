+  private fun withConfidence(hypothesis: String, text: String): String {
+    val confidence: Double? = try {
+      val words = JSONObject(hypothesis).optJSONArray("result")
+      if (words == null || words.length() == 0) {
+        null
+      } else {
+        var sum = 0.0
+        for (i in 0 until words.length()) {
+          sum += words.getJSONObject(i).optDouble("conf", 0.0)
+        }
