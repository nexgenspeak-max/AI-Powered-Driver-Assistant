{
  "expo": {
    "name": "customer-app",
    "slug": "customer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.customerapp",
      "bitcode": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Czen needs microphone access so you can talk to the AI assistant.",
        "NSLocationWhenInUseUsageDescription": "Czen needs your location to suggest your pickup point when booking a ride."
      }
    },
    "android": {
      "package": "com.anonymous.customerapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@config-plugins/react-native-webrtc",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": { "audioType": "communication" }
        }
      ],
      "./plugins/withForegroundService.js",
      "./plugins/withGestureExclusion.js",
      [
        "react-native-vosk",
        {
          "models": ["assets/model-vi-vn"]
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Czen needs your location to suggest your pickup point when booking a ride."
        }
      ]
    ],
    "scheme": "customer-app"
  }
}