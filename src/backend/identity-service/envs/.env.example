# identity-service (Dịch vụ Định danh) — copy to envs/.env.local
ENV=local
PORT=8003
AWS_REGION=ap-southeast-1
# AWS_PROFILE=your-profile-name

# Issues login JWTs; every other service verifies with the same secret.
# Local default is dev-secret-change-me when empty.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

DYNAMODB_TABLE=local-driver-assistant-accounts
DYNAMODB_SETTINGS_TABLE=local-driver-assistant-driver-settings

# Optional file sink for Super Admin live tail (ops-service)
LOG_DIR=../../../logs
SERVICE_NAME=identity-service
