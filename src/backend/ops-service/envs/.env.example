# ops-service (Dịch vụ Giám sát vận hành) — copy to envs/.env.local
ENV=local
PORT=8004

# Must match JWT_SECRET in identity-service (Super Admin token is verified here)
JWT_SECRET=

LOG_DIR=../../../logs
SERVICE_NAME=ops-service
LOG_FRESHNESS_MS=30000

# llm-orchestrator (Tác tử hội thoại giọng nói) source + logs
# (legacy names VOICE_AGENT_ROOT / VOICE_AGENT_LOG_DIR still accepted)
LLM_ORCHESTRATOR_ROOT=../llm-orchestrator
LLM_ORCHESTRATOR_LOG_DIR=../llm-orchestrator/logs

# Health probes (legacy AUTH_/TRIP_/CALL_CENTER_/CALL_LOGGER_HEALTH_URL still accepted)
IDENTITY_HEALTH_URL=http://localhost:8003/health
EXTERNAL_API_HEALTH_URL=http://localhost:8002/health
EXTERNAL_CHANNEL_HEALTH_URL=http://localhost:8000/health
CALL_RECORDS_HEALTH_URL=http://localhost:8001/health
OPS_HEALTH_URL=http://localhost:8004/health

# call-records-service proxy (legacy CALL_LOGGER_URL still accepted)
CALL_RECORDS_SERVICE_URL=http://localhost:8001

# Daily operations report (Dịch vụ Giám sát vận hành)
# DynamoDB table; empty = local JSON files in data/reports (dev only)
REPORTS_TABLE=
# LLM grading of a daily sample of driver exchanges ("tỷ lệ trả lời đúng"); empty key = not graded
OPENAI_API_KEY=
REPORT_JUDGE_MODEL=gpt-4o-mini
REPORT_JUDGE_SAMPLE=30
# off = do not run the in-process daily scheduler (local only; AWS uses EventBridge Scheduler)
REPORT_SCHEDULER=on
