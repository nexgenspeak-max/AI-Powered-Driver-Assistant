TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
BASE_URL=https://your-subdomain.ngrok-free.app   # local only
ENV=local
# Must match JWT_SECRET in identity-service (REST dial/sms/list; Twilio webhooks stay open)
JWT_SECRET=
AWS_REGION=ap-southeast-1
# AWS_PROFILE=your-profile-name

# Optional file sink for Super Admin live tail (ops-service)
LOG_DIR=../../../logs
SERVICE_NAME=external-channel-service
