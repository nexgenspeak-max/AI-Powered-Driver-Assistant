# Secrets only. Providers, models, URLs, and voices live in envs/config.example.toml
# (copy that file to config.local.toml). A value set here overrides the toml file.

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CREDENTIALS_JSON=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# Must match identity-service and external-api-service. Local default is dev-secret-change-me when empty.
JWT_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
