ENV=local
DYNAMODB_TABLE=local-driver-assistant-trips

# Must match JWT_SECRET in auth-service/envs/.env.local
JWT_SECRET=
AUTH_SERVICE_URL=http://localhost:8003

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=driver-assistant-local
SIP_TRUNK_ID=

# Google Maps — get key from console.cloud.google.com → Directions API
GOOGLE_MAPS_API_KEY=

# AWS
# AWS_PROFILE=your-profile-name
AWS_REGION=ap-southeast-1

# Cache (optional — in-memory fallback when unset)
REDIS_URL=
CACHE_TTL_SECONDS=120

# Call services
CALL_LOGGER_URL=http://localhost:8001
CALL_CENTER_URL=http://localhost:8000

# Phone used to seed/test trips locally
DEFAULT_DRIVER_PHONE=

# Twilio trial account can only dial numbers verified in the Twilio Console
# (Phone Numbers → Verified Caller IDs) — background customer calls redirect
# here instead of the real customer number until the account is upgraded.
TWILIO_VERIFIED_TO=
