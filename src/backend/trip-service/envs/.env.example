ENV=local
DYNAMODB_TABLE=local-driver-assistant-trips
DYNAMODB_DELIVERY_ORDERS_TABLE=local-driver-assistant-delivery-orders

# Must match JWT_SECRET in auth-service/envs/.env.local
JWT_SECRET=
AUTH_SERVICE_URL=http://localhost:8003
# voice-agent's vision-api sidecar — reads delivery-order photos
# (POST /delivery-orders/scan). Run `uvicorn app.vision_api.main:app --port 8080`
# from src/backend/voice-agent for local dev.
VOICE_AGENT_URL=http://localhost:8080

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=driver-assistant-local
SIP_TRUNK_ID=

# Maps provider — "google" or "goong". Swapping providers only needs these two lines,
# no code change (see src/services/mapsService.ts).
MAPS_PROVIDER=goong
# google: console.cloud.google.com → Directions API
# goong: goong.io dashboard → API Key (not Maptiles Key)
MAPS_API_KEY=

# AWS
# AWS_PROFILE=your-profile-name
AWS_REGION=ap-southeast-1

# Cache (optional — in-memory fallback when unset)
REDIS_URL=
CACHE_TTL_SECONDS=120

# Call services
CALL_LOGGER_URL=http://localhost:8001
CALL_CENTER_URL=http://localhost:8000

# Phone used to seed/test trips locally
DEFAULT_DRIVER_PHONE=

# Twilio trial account can only dial numbers verified in the Twilio Console
# (Phone Numbers → Verified Caller IDs) — background customer calls redirect
# here instead of the real customer number until the account is upgraded.
TWILIO_VERIFIED_TO=
