{
  "name": "external-api-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/local.ts",
    "build": "tsc",
    "verify:logger": "ts-node --transpile-only src/services/logger/selfcheck.ts",
    "verify:telephony": "ts-node --transpile-only src/services/telephony/selfcheck.ts",
    "verify:ws": "ts-node --transpile-only src/services/notify/selfcheck.ts",
    "verify:sms": "ts-node --transpile-only src/services/sms/selfcheck.ts",
    "verify:driver-status": "ts-node --transpile-only src/services/driverStatus/selfcheck.ts",
    "verify:customers": "ts-node --transpile-only src/services/customers.selfcheck.ts",
    "verify:reminders": "ts-node --transpile-only src/services/reminder.selfcheck.ts",
    "verify:trip-access": "ts-node --transpile-only src/services/trips/access.selfcheck.ts",
    "verify:jwt-cross": "ts-node --transpile-only -P tsconfig.json ../cross-checks/jwt_cross.selfcheck.ts"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1101.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.1101.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.6.0",
    "serverless-http": "^3.2.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.23.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
