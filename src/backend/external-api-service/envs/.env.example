# external-api-service (Dịch vụ Chuyến đi và Điều phối) — copy to envs/.env.local
ENV=local
PORT=8002
DYNAMODB_TABLE=local-driver-assistant-trips

# Must match JWT_SECRET in identity-service/envs/.env.local
JWT_SECRET=

# Downstream services (legacy names AUTH_SERVICE_URL / CALL_LOGGER_URL / CALL_CENTER_URL still accepted)
IDENTITY_SERVICE_URL=http://localhost:8003
CALL_RECORDS_SERVICE_URL=http://localhost:8001
EXTERNAL_CHANNEL_SERVICE_URL=http://localhost:8000

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=driver-assistant-local
SIP_TRUNK_ID=

# Zalo Cloud Connect (optional second outbound channel — in-app Zalo call, not PSTN)
# Register a second LiveKit outbound SIP trunk → ZCC per Zalo docs.
ZALO_SIP_TRUNK_ID=
ZALO_APP_ID=
ZALO_ACCESS_TOKEN=
ZALO_CONSENT_REASON_CODE=103
# Local dev only — bypass consent cache gate (never true in prod)
ZALO_SKIP_CONSENT_CHECK=false
TELEPHONY_DEFAULT_CHANNEL=phone

# Maps provider — "google" or "goong". Swapping providers only needs these two lines,
# no code change (see src/services/mapsService.ts).
MAPS_PROVIDER=goong
# google: console.cloud.google.com → Directions API
# goong: goong.io dashboard → API Key (not Maptiles Key)
MAPS_API_KEY=

# AWS
# AWS_PROFILE=your-profile-name
AWS_REGION=ap-southeast-1

# Cache (optional — in-memory fallback when unset)
REDIS_URL=
CACHE_TTL_SECONDS=120

# Phone used to seed/test trips locally when POST body omits driver_phone.
# Leave empty in non-local / shared envs — production clients must send driver_phone.
DEFAULT_DRIVER_PHONE=

# Optional file sink for Super Admin live tail (ops-service)
LOG_DIR=../../../logs
SERVICE_NAME=external-api-service

# Twilio trial account can only dial numbers verified in the Twilio Console
# (Phone Numbers → Verified Caller IDs) — background customer calls redirect
# here instead of the real customer number until the account is upgraded.
TWILIO_VERIFIED_TO=

# Prefix of every SMS to customers, e.g. [Czen]
SMS_SENDER_LABEL=
