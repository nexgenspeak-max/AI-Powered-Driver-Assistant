ENV=local

# Must match JWT_SECRET in identity-service (verify only — no login here)
JWT_SECRET=

# DynamoDB — for local dev, use a local DynamoDB or leave as-is and use real AWS
DYNAMODB_TABLE=local-driver-assistant-call-records

# AWS
# AWS_PROFILE=your-profile-name
AWS_REGION=ap-southeast-1

# Optional file sink for Super Admin live tail (ops-service)
LOG_DIR=../../../logs
SERVICE_NAME=call-records-service
