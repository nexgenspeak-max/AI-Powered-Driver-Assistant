# ── LiveKit ───────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Provider selection — change these to switch without rewriting code ────────
STT_PROVIDER=openai          # openai | deepgram | google | inference
STT_MODEL=whisper-1          # openai: whisper-1 | deepgram: nova-2 | google: chirp_2, chirp_3, latest_long | inference: deepgram/nova-3, cartesia/ink-whisper
STT_LANGUAGE=vi-VN           # BCP-47; comma-separated for Google multi-language

LLM_PROVIDER=openai          # openai | anthropic | google | kimi
LLM_MODEL=gpt-5.6-luna       # gpt-5.6-luna (voice, reasoning none) | gpt-4o | gpt-4o-mini | moonshotai/kimi-k2.6

TTS_PROVIDER=google           # google (vi-VN native) | elevenlabs | gemini | openai
TTS_VOICE=                    # leave empty to use provider default below

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Kimi ────────────────────────────────────────────────────────────────────
# Set KIMI_API_KEY to call Moonshot's own OpenAI-compatible API directly
# (bypasses LiveKit Inference Gateway's own credit quota entirely). Leave
# empty to route through LiveKit Inference instead — uses LIVEKIT_API_KEY/
# SECRET above, no separate key needed, but shares LiveKit's Gateway credit.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_PROVIDER=   # optional: force a specific inference provider (e.g. baseten) — only used via the LiveKit Inference route

# STT_PROVIDER=inference uses the same LiveKit Inference route as Kimi above
# (no separate key) — set STT_MODEL to a "provider/model" string instead.

# ── Deepgram ──────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=

# ── Google Cloud STT + TTS ───────────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=./envs/credentials.json   # local dev
GOOGLE_CREDENTIALS_JSON=                           # AWS (paste full JSON string)
GOOGLE_STT_MODEL=chirp_3
GOOGLE_STT_LOCATION=us   # chirp_3: us | eu (not asia-southeast1); chirp_2: asia-southeast1 | us
# vi-VN compatibility: chirp_2+asia-southeast1 ✓ | chirp_3+us ✓ | latest_long+global ✓ | chirp_3+asia-southeast1 ✗ | telephony ✗
GOOGLE_TTS_VOICE=vi-VN-Chirp3-HD-Kore   # native VN + streaming; vi-VN-Chirp3-HD-Charon = male
GOOGLE_TTS_SPEAKING_RATE=0.95      # slightly slower = clearer numbers/addresses
GOOGLE_TTS_PITCH=-2.0              # subtle Northern downward tone

# ── Gemini TTS (TTS_PROVIDER=gemini) ─────────────────────────────────────────
# Reuses GOOGLE_CREDENTIALS_FILE via Vertex (GEMINI_TTS_USE_VERTEXAI=true), or set GOOGLE_API_KEY.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_LOCATION=us-central1
GEMINI_TTS_USE_VERTEXAI=true
# GEMINI_TTS_INSTRUCTIONS=Speak in Vietnamese (Northern accent)...

# ── ElevenLabs ───────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=s6W2NupNY6TykGJoDtWy   # Adam (multilingual)
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── Cartesia ──────────────────────────────────────────────────────────────────
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# ── Downstream services ───────────────────────────────────────────────────────
CALL_LOGGER_URL=http://localhost:8001   # leave empty to skip saving call records locally
TRIP_SERVICE_URL=http://localhost:8002
# Must match JWT_SECRET used by auth-service and trip-service
JWT_SECRET=

# ── FAQ RAG (LlamaIndex playbook) ─────────────────────────────────────────────
FAQ_RAG_ENABLED=true
FAQ_KNOWLEDGE_DIR=requirements/knowledge   # sources: knowledge/vi/, knowledge/en/
FAQ_INDEX_DIR=data/faq_index               # vectors: faq_index/vi/, faq_index/en/
FAQ_EMBED_MODEL=text-embedding-3-small
FAQ_TOP_K=4

# ── Silence tracker (local / iOS simulator has no real mic) ───────────────────
SILENCE_TRACKER_ENABLED=true
SILENCE_THRESHOLD_SECONDS=0          # 0 = driver 10s×2 (~20s); customer mode 60s×3
SILENCE_MAX_CONSECUTIVE=0            # 0 = driver 2 strikes (1 check-in + goodbye)
SILENCE_END_SESSION=true             # false stops check-ins but keeps room open (debug only)

ENV=local

# ── Dev traces (prefix "DEV " in console + logs/agent.<pid>.log) ─────────────
# LOG_LEVEL=INFO   # default; set WARNING to hide DEV lines
# grep:  grep 'DEV ' logs/agent.*.log

# ── Twilio ───────────────────────────────────────────────────────────────────────
TWILIO_PHONE_NUMBER=+19068288788
TWILIO_ACCOUNT_SID=ACxxxxxxxx...
TWILIO_AUTH_TOKEN=xxxxxxxx...